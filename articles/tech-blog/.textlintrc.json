{
  "filters": {
    "comments": true
  },
  "rules": {
    "preset-ja-technical-writing": {
      "no-exclamation-question-mark": false,
      "ja-no-successive-word": {
        "allow": ["─"]
      }
    },
    "preset-jtf-style": {
      "4.2.1.感嘆符(！)": false,
      "1.1.2.見出し": false,
      "4.3.2.大かっこ［］": false
    },
    "prh": {
      "rulePaths": ["../prh-rules.yml"]
    }
  }
}
