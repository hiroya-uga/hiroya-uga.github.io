{
  "filters": {
    "comments": true
  },
  "rules": {
    "no-doubled-joshi": {
      "severity": "warning"
    },
    "sentence-length": {
      "severity": "warning"
    },
    "max-ten": true,
    "max-kanji-continuous-len": {
      "max": 6
    },
    "preset-jtf-style": {
      "1.1.2.見出し": false
    }
  }
}
